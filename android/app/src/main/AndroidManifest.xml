<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Stage 3 (F6) — Google OAuth deep-link callback. Google's
                 sign-in flow can't complete inside an embedded WebView, so
                 sign-in opens in the system browser instead; this
                 intent-filter is what lets Android route the browser's
                 redirect back into this app (into the existing instance,
                 per launchMode="singleTask" above) rather than opening a
                 browser tab with nowhere to go. Must match the redirectTo
                 URL used in useAuth.js's signInWithGoogle() and the
                 redirect URL added to Supabase's dashboard allow-list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.capsula.app" android:host="auth-callback" />
            </intent-filter>

        </activity>

        <!-- Stage 5 (F6) — custom notification icon for FCM. Without this,
             push notifications fall back to a system default icon instead
             of the app's own mark. Must be a plain white silhouette on a
             transparent background (Android tints it itself in the status
             bar) — see res/drawable-*/ic_stat_notify.png. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Bug fix, 2026-08-17 (notif-display-fix) — required on Android 13+
         (API 33+) for the OS to display any notification at all, separate
         from the in-app permission prompt FirebaseMessaging.requestPermissions()
         shows. Without this declared, FCM delivery can succeed server-side
         while the OS silently drops the notification before it ever
         reaches the screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
